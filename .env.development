# Docker Compose project name → префикс контейнеров: mas-payments-dev-*
#   mas-payments-dev-frontend-1, mas-payments-dev-mas-payments-1, mas-payments-dev-db-1
COMPOSE_PROJECT_NAME=mas-payments-dev

# Frontend
FRONTEND_PATH=../MAS.Payments.Client
FRONTEND_PORT=5051

# Backend
BACKEND_PORT=80
BACKEND_HOST_PORT=5174

# Database
POSTGRES_IMAGE=postgres:15
POSTGRES_DB=prt
POSTGRES_USER=devw
POSTGRES_PASSWORD=123
POSTGRES_PORT=5402

# Connection string (assembled from DB vars above)
CONNECTION_STRING=Host=db;Port=5432;Pooling=true;Database=prt;Username=devw;Password=123;Timeout=5;
