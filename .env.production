# Docker Compose project name → префикс контейнеров: mas-payments-prod-*
#   mas-payments-prod-frontend-1, mas-payments-prod-mas-payments-1, mas-payments-prod-db-1
COMPOSE_PROJECT_NAME=mas-payments-prod

# Frontend
FRONTEND_PATH=../MAS.Payments.Client
FRONTEND_PORT=5050

# Backend
BACKEND_PORT=80
BACKEND_HOST_PORT=5174

# Database
POSTGRES_IMAGE=postgres:15
POSTGRES_DB=prt
POSTGRES_USER=devw
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5401

# Connection string (update password to match POSTGRES_PASSWORD above)
CONNECTION_STRING=Host=db;Port=5432;Pooling=true;Database=prt;Username=devw;Password=change_me;Timeout=5;
